#!/usr/bin/env bash
# dewfpga web installer.
#   curl -fsSL https://nosey-dewdrop.github.io/dewfpga/install | bash
# Downloads the CLI into ~/.dewfpga (sha256 compared with dewfpga.tgz.sha256 from the same site: an integrity
# check against a broken download, not a signature), links `dewfpga` into
# Homebrew's bin, then runs `dewfpga install` (the toolchain, ~4 min). Re-run the same line to update.
# DEWFPGA_DIR picks another folder. The folder is replaced, so it must be empty or an earlier dewfpga install:
# never $HOME, /, a parent of $HOME, or a folder with your own files in it.
# The whole script is one function, so a download that stops halfway runs nothing.
set -euo pipefail
main() {
    local BASE="${DEWFPGA_URL:-https://nosey-dewdrop.github.io/dewfpga}"
    local DIR="${DEWFPGA_DIR:-$HOME/.dewfpga}"
    die() { echo "ERROR: $*" >&2; exit 1; }
    # the physical path (symlinks resolved) of a path that may not exist yet: resolve its nearest existing parent
    physical() {
        local p=$1 rest="" b top
        [[ $p = /* ]] || p="$PWD/$p"
        while [ ! -d "$p" ]; do
            b=$(basename "$p")
            # `nope/..` cannot be resolved while nope does not exist, and once mkdir -p makes it the path means another folder
            case $b in .|..) die "DEWFPGA_DIR=$DIR has a . or .. after a folder that does not exist yet; give the plain path." ;; esac
            rest="/$b$rest"; p=$(dirname "$p")
        done
        top=$(cd "$p" 2>/dev/null && pwd -P) && [ -n "$top" ] || die "DEWFPGA_DIR=$DIR goes through $p, which cannot be opened; give a path you can open."
        # ${top%/} turns / into nothing: an empty path would pass every guard below
        local out="${top%/}$rest"; printf '%s' "${out:-/}"
    }

    # Homebrew on the PATH, or the reason it is not. The same three cases as install.sh's need_brew: brew in
    # /opt/homebrew that the "Next steps" lines never put on the PATH (the message prints the line to paste), an Intel
    # brew in /usr/local, none. The candidates are only tested with -x, never run. DEWFPGA_BREW_PATHS (test only) is a
    # space-separated list of candidate paths; the real two have no space, so it does not take one either.
    need_brew() {
        local found b line="/bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
        found=$(command -v brew || true)
        if [ -n "$found" ]; then
            case $found in
                */usr/local/bin/brew)
                    die "the brew command on your PATH is $found, the Intel Homebrew location. This installer needs the Apple Silicon Homebrew in /opt/homebrew. If /opt/homebrew/bin/brew exists, put /opt/homebrew/bin before /usr/local/bin on your PATH using Homebrew's Next steps; otherwise install it: $line (https://docs.brew.sh/Installation)" ;;
                *) return 0 ;;
            esac
        fi
        # shellcheck disable=SC2086  # the list is space-separated by design
        for b in ${DEWFPGA_BREW_PATHS:-/opt/homebrew/bin/brew /usr/local/bin/brew}; do
            [ -x "$b" ] || continue
            case $b in
                */opt/homebrew/bin/brew)
                    die "Homebrew is installed ($b) but not on your PATH: the lines the Homebrew installer printed under \"Next steps\" were not pasted (they put ${b%/brew} on the PATH, see https://docs.brew.sh/Installation). Put it there, open a new terminal window and run the curl line again:
    echo 'export PATH=\"${b%/brew}:\$PATH\"' >> ~/.zprofile" ;;
                *)
                    die "an Intel Homebrew was found at $b (not on your PATH; it runs under Rosetta and would build Intel tools). On Apple Silicon install the arm64 Homebrew, it goes to /opt/homebrew:  $line   (https://brew.sh)" ;;
            esac
        done
        die "Homebrew missing. First:  $line   then paste the lines it prints under \"Next steps\", open a new terminal window and run the curl line again   (https://brew.sh)"
    }

    [ "$(uname -s)" = Darwin ] || die "dewfpga is for macOS."
    [ "$(uname -m)" = arm64 ]  || die "only Apple Silicon (arm64) is supported for now."
    [ "$(id -u)" -ne 0 ]       || die "do not run with sudo."
    need_brew

    # DEWFPGA_DIR is replaced below. Refuse anything that is not an empty folder or an earlier dewfpga install.
    [ -n "$DIR" ] || die "DEWFPGA_DIR is empty."
    [[ $DIR != *[[:space:]]* ]] || die "DEWFPGA_DIR=$DIR contains a space; the FPGA tools cannot handle that path."
    local real home; real=$(physical "$DIR") || exit 1; home=$(physical "$HOME") || exit 1
    case "$real" in
        /|"$home"|"$home"/) die "DEWFPGA_DIR=$DIR is $real; refusing to replace that folder. Use an empty folder (default ~/.dewfpga)." ;;
    esac
    # -ef as well as the strings: //Users/you or /users/YOU (APFS ignores case) name the same folder
    [ ! "$real" -ef "$HOME" ] || die "DEWFPGA_DIR=$DIR is your home folder; refusing to replace that. Use an empty folder (default ~/.dewfpga)."
    local up=$home
    while [ "$up" != / ] && [ -n "$up" ]; do
        up=$(dirname "$up")
        [ ! "$real" -ef "$up" ] || die "DEWFPGA_DIR=$DIR is $real, a parent of your home folder; refusing to replace that. Use an empty folder (default ~/.dewfpga)."
    done
    if [ -e "$real" ] && [ ! -d "$real" ]; then die "DEWFPGA_DIR=$DIR exists and is not a folder."; fi
    # a folder that cannot be read looks empty to a bare `ls -A`; its files would be moved aside unseen and never removed
    local inside=""
    if [ -d "$real" ]; then inside=$(ls -A -- "$real" 2>/dev/null) || die "DEWFPGA_DIR=$DIR cannot be read, so what is inside cannot be checked; refusing to replace it. Fix: chmod u+rwx on it, or use an empty folder (default ~/.dewfpga)."; fi
    if [ -n "$inside" ]; then
        # a git clone of the repo has bin/dewfpga and package.json too, plus .git (a file in a worktree) and work in progress
        [ ! -e "$real/.git" ] && [ ! -L "$real/.git" ] || die "DEWFPGA_DIR=$DIR is a git clone; refusing to replace it. Use an empty folder (default ~/.dewfpga)."
        # a dewfpga install carries its own bin/dewfpga and package.json; anything else is somebody's files
        if ! { [ -f "$real/bin/dewfpga" ] && grep '"name": *"dewfpga"' "$real/package.json" >/dev/null 2>&1; }; then
            die "DEWFPGA_DIR=$DIR is not empty and not a dewfpga install; refusing to replace its contents. Use an empty folder (default ~/.dewfpga)."
        fi
    fi

    local tmp; tmp=$(mktemp -d)
    echo "downloading $BASE/dewfpga.tgz"
    curl -fsSL "$BASE/dewfpga.tgz"        -o "$tmp/dewfpga.tgz"        || { rm -rf "$tmp"; die "download failed"; }
    curl -fsSL "$BASE/dewfpga.tgz.sha256" -o "$tmp/dewfpga.tgz.sha256" || { rm -rf "$tmp"; die "checksum download failed"; }
    (cd "$tmp" && LC_ALL=C shasum -a 256 -c dewfpga.tgz.sha256 >/dev/null) || { rm -rf "$tmp"; die "sha256 mismatch: the download is incomplete or corrupt. Try again."; }
    # extract into a staging folder first: a bad archive leaves the current install in place
    mkdir -p "$tmp/new"
    tar -xzf "$tmp/dewfpga.tgz" -C "$tmp/new" --strip-components 1 || { rm -rf "$tmp"; die "extract failed"; }
    [ -f "$tmp/new/bin/dewfpga" ] && [ -f "$tmp/new/install.sh" ] || { rm -rf "$tmp"; die "extract failed: the archive is not a dewfpga release"; }
    # the old tree steps aside, the new one moves in, and the old one is removed only then: a failed move puts it back
    mkdir -p "$(dirname "$real")"
    local backup old
    backup=$(mktemp -d "$(dirname "$real")/.dewfpga-backup.XXXXXX") || { rm -rf "$tmp"; die "could not reserve a backup folder beside $real"; }
    old="$backup/old"
    # a failed move leaves the earlier install where it was; the empty backup folder goes, a half-copied one stays (the message names it)
    if [ -d "$real" ]; then mv "$real" "$old" || { rm -rf "$tmp"; rmdir "$backup" 2>/dev/null || true; die "could not move the earlier install aside, to $old"; }; fi
    if ! mv "$tmp/new" "$real"; then
        # no step here may end the script before its message (set -e would): a cleanup that fails is named in it instead
        rm -rf "$tmp" 2>/dev/null || true
        local left=""
        # a move that failed halfway leaves part of the new tree at $real, and mv would put the old one inside it
        if [ -e "$real" ] && ! rm -rf "$real" 2>/dev/null; then left=" A half-moved copy is left at $real; remove it before the next run."; fi
        if [ ! -d "$old" ]; then
            rmdir "$backup" 2>/dev/null || left="$left The empty backup folder $backup is left too."
            die "could not move the files into $real.$left"
        fi
        if [ ! -e "$real" ] && mv "$old" "$real" 2>/dev/null && [ -d "$real" ] && [ ! -e "$old" ]; then
            rmdir "$backup" 2>/dev/null || true
            die "could not move the files into $real; the earlier install is back in place"
        fi
        die "could not move the files into $real, nor the earlier install back; it is in $old.$left"
    fi
    rm -rf "$tmp" 2>/dev/null || true
    # a fresh tree: files removed upstream do not linger. The earlier install is in place of nothing now, so a copy
    # that cannot be removed (a locked folder inside it) is named, not left unexplained by set -e
    if ! rm -rf "$backup" 2>/dev/null; then
        echo "note: the earlier install could not be removed; it is in $old, the new one is in place. Check the backup's permissions and remove it manually when it is no longer needed." >&2
    fi
    chmod +x "$real/bin/dewfpga" "$real/install.sh"

    local BIN; BIN="$(brew --prefix)/bin"
    if [ -w "$BIN" ]; then
        ln -sfn "$real/bin/dewfpga" "$BIN/dewfpga"
        echo "dewfpga $("$real/bin/dewfpga" --version) -> $BIN/dewfpga   (sha256 ok)"
    else
        echo "$BIN is not writable. Add to your PATH:  export PATH=\"$real/bin:\$PATH\""
    fi
    echo
    exec "$real/bin/dewfpga" install
}
main "$@"
