#!/usr/bin/env bash
# mac-fpga — macOS'ta Vivado'suz Basys3.
#   mac-fpga install        zinciri kur (~/fpga altına, yeniden çalıştırılabilir)
#   mac-fpga check          altı parça yerinde mi
#   mac-fpga new <dizin>    LED yakan örnek projeyi aç (blink.sv + xdc + Makefile)
#   mac-fpga sim | bit | flash | clean [top]   (mac-fpga --version)
#                           bulunduğun klasördeki <top>.sv + <top>.xdc ile çalış
#                           (top verilmezse klasördeki tek .sv dosyasından bulunur)
set -euo pipefail
# symlink zinciri çöz (npm bin / brew bin). readlink -f eski macOS'ta yok, elle:
resolve() { local f=$1 d; while [ -L "$f" ]; do d=$(cd "$(dirname "$f")" && pwd); f=$(readlink "$f"); [[ $f = /* ]] || f="$d/$f"; done; printf '%s' "$f"; }
SELF="$(resolve "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")/.." && pwd)"
FPGA_HOME="${FPGA_HOME:-$HOME/fpga}"

usage() { sed -n '2,8p' "$SELF"; exit "${1:-0}"; }
version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$HERE/package.json"; }

cmd_check() {
    local fail=0
    row() {  # <ad> <yol|komut> <tür f|x|c>
        local name=$1 target=$2 kind=$3 where=""
        case $kind in
            c) where=$(command -v "$target" 2>/dev/null || true) ;;
            x) [ -x "$target" ] && where=$target ;;
            f) [ -s "$target" ] && where=$target ;;
        esac
        if [ -n "$where" ]; then printf '  \033[32m✓\033[0m %-16s %s\n' "$name" "$where"
        else printf '  \033[31m✗\033[0m %-16s YOK\n' "$name"; fail=1; fi
    }
    echo "mac-fpga check  (FPGA_HOME=$FPGA_HOME)"
    row yosys           yosys                                            c
    row iverilog        iverilog                                         c
    row openFPGALoader  openFPGALoader                                   c
    row nextpnr-xilinx  "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" x
    row xc7frames2bit   "$FPGA_HOME/prjxray/build/tools/xc7frames2bit"   x
    row fasm2frames     "$FPGA_HOME/prjxray/utils/fasm2frames.py"        f
    row chipdb          "$FPGA_HOME/chipdb/xc7a35t.bin"                  f
    row venv            "$FPGA_HOME/venv/bin/python"                     x
    if [ -x "$FPGA_HOME/venv/bin/python" ]; then
        if "$FPGA_HOME/venv/bin/python" -c "import fasm, prjxray, yaml, textx, simplejson, intervaltree" 2>/dev/null
        then printf '  \033[32m✓\033[0m %-16s fasm prjxray pyyaml textx simplejson intervaltree\n' "python pkgs"
        else printf '  \033[31m✗\033[0m %-16s eksik paket\n' "python pkgs"; fail=1; fi
    fi
    if [ $fail -eq 0 ]; then echo "hepsi yerinde."; else echo "eksik var -> mac-fpga install"; return 1; fi
}

cmd_new() {
    local dir=${1:-}; [ -n "$dir" ] || usage 1
    [ -e "$dir" ] && { echo "HATA: $dir zaten var" >&2; exit 1; }
    mkdir -p "$dir/.vscode"
    cp "$HERE"/templates/{blink.sv,blink_tb.sv,blink.xdc,Basys3_Master.xdc,check_xdc.py,Makefile} "$dir/"
    cp "$HERE"/templates/.vscode/tasks.json "$dir/.vscode/"
    echo "$dir/ hazır:  cd $dir && make flash    (VS Code'da ⌘⇧B)"
}

cmd_build() {  # <hedef> [top]
    local target=$1 top=${2:-}
    if [ -z "$top" ]; then
        # top = .xdc'si olan .sv; o da belirsizse klasördeki tek .sv
        local f svs=() withxdc=()
        for f in *.sv; do
            [ -f "$f" ] && [[ $f != *_tb.sv ]] || continue
            svs+=("$f"); [ -f "${f%.sv}.xdc" ] && withxdc+=("$f")
        done
        if   [ ${#withxdc[@]} -eq 1 ]; then top=${withxdc[0]%.sv}
        elif [ ${#svs[@]} -eq 1 ];     then top=${svs[0]%.sv}
        else echo "HATA: top modül belirsiz (${#svs[@]} .sv, ${#withxdc[@]} .xdc eşleşmesi); ->  mac-fpga $target <top>" >&2; exit 1; fi
    fi
    [ -f "$top.sv" ] || [ -f "$top.v" ] || { echo "HATA: $top.sv yok" >&2; exit 1; }
    # klasördeki TÜM kaynaklar sentezlenir (alt modüller ayrı dosyada olabilir); testbench hariç
    local srcs=()
    for f in *.sv *.v; do [ -f "$f" ] && [[ $f != *_tb.sv && $f != *_tb.v ]] && srcs+=("$f"); done
    case $target in
        sim)
            [ -f "${top}_tb.sv" ] || { echo "HATA: ${top}_tb.sv yok. Simülasyon için testbench gerekli (örnek: mac-fpga new ornek)" >&2; exit 1; } ;;
        bit|flash)
            [ -f "$top.xdc" ] || { echo "HATA: $top.xdc yok. Pinleri Basys3_Master.xdc'den kopyala:  $HERE/templates/Basys3_Master.xdc" >&2; exit 1; }
            [ -s "$FPGA_HOME/chipdb/xc7a35t.bin" ] && [ -x "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" ] \
                || { echo "HATA: zincir kurulu değil. Önce:  mac-fpga install   (durum: mac-fpga check)" >&2; exit 1; } ;;
    esac
    exec make -s -f "$HERE/templates/Makefile" TOP="$top" SRCS="${srcs[*]}" XDC="$top.xdc" "$target"
}

case "${1:-}" in
    install) shift; exec bash "$HERE/install.sh" "$@" ;;
    check)   cmd_check ;;
    new)     shift; cmd_new "$@" ;;
    sim|bit|flash|clean) cmd_build "$@" ;;
    -v|--version|version) version ;;
    -h|--help|help|"") usage ;;
    *) echo "bilinmeyen komut: $1" >&2; usage 1 ;;
esac
