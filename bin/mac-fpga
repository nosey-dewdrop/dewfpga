#!/usr/bin/env bash
# mac-fpga — Basys3 on macOS without Vivado.
#   mac-fpga install                 install the toolchain into ~/fpga (safe to re-run)
#   mac-fpga check                   verify every piece is in place
#   mac-fpga sim | bit | flash | clean [top]
#                                    work on the .sv files in the current folder; top = the .sv
#                                    that has a matching .xdc (or the only .sv); else name it
#   mac-fpga new <dir>               example project: blink.sv + blink.xdc + Makefile + VS Code task
#   mac-fpga --version
set -euo pipefail
# resolve symlink chain (npm bin / brew bin). readlink -f is missing on older macOS, so by hand:
resolve() { local f=$1 d; while [ -L "$f" ]; do d=$(cd "$(dirname "$f")" && pwd); f=$(readlink "$f"); [[ $f = /* ]] || f="$d/$f"; done; printf '%s' "$f"; }
SELF="$(resolve "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")/.." && pwd)"
FPGA_HOME="${FPGA_HOME:-$HOME/fpga}"

usage()   { sed -n '2,9p' "$SELF"; exit "${1:-0}"; }
version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$HERE/package.json"; }
die()     { echo "ERROR: $*" >&2; exit 1; }

cmd_check() {
    local fail=0
    row() {  # <name> <path|command> <kind f|x|c>
        local name=$1 target=$2 kind=$3 where=""
        case $kind in
            c) where=$(command -v "$target" 2>/dev/null || true) ;;
            x) [ -x "$target" ] && where=$target ;;
            f) [ -s "$target" ] && where=$target ;;
        esac
        if [ -n "$where" ]; then printf '  \033[32m✓\033[0m %-16s %s\n' "$name" "$where"
        else printf '  \033[31m✗\033[0m %-16s MISSING\n' "$name"; fail=1; fi
    }
    echo "mac-fpga check  (FPGA_HOME=$FPGA_HOME)"
    row yosys           yosys                                            c
    row iverilog        iverilog                                         c
    row openFPGALoader  openFPGALoader                                   c
    row nextpnr-xilinx  "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" x
    row xc7frames2bit   "$FPGA_HOME/prjxray/build/tools/xc7frames2bit"   x
    row fasm2frames     "$FPGA_HOME/prjxray/utils/fasm2frames.py"        f
    row chipdb          "$FPGA_HOME/chipdb/xc7a35t.bin"                  f
    row venv            "$FPGA_HOME/venv/bin/python"                     x
    if [ -x "$FPGA_HOME/venv/bin/python" ]; then
        if "$FPGA_HOME/venv/bin/python" -c "import fasm, prjxray, yaml, textx, simplejson, intervaltree" 2>/dev/null
        then printf '  \033[32m✓\033[0m %-16s fasm prjxray pyyaml textx simplejson intervaltree\n' "python pkgs"
        else printf '  \033[31m✗\033[0m %-16s missing package\n' "python pkgs"; fail=1; fi
    fi
    if [ $fail -eq 0 ]; then echo "all good."; else echo "something is missing -> mac-fpga install"; return 1; fi
}

cmd_new() {
    local dir=${1:-}; [ -n "$dir" ] || usage 1
    [ -e "$dir" ] && die "$dir already exists"
    mkdir -p "$dir/.vscode"
    cp "$HERE"/templates/{blink.sv,blink_tb.sv,blink.xdc,Basys3_Master.xdc,check_xdc.py,Makefile} "$dir/"
    cp "$HERE"/templates/.vscode/tasks.json "$dir/.vscode/"
    echo "$dir/ ready:  cd $dir && make flash    (VS Code: ⌘⇧B)"
}

cmd_build() {  # <target> [top]
    local target=$1 top=${2:-}
    if [ -z "$top" ]; then
        # top = the .sv that has a matching .xdc; if ambiguous, the only .sv in the folder
        local f svs=() withxdc=()
        for f in *.sv; do
            [ -f "$f" ] && [[ $f != *_tb.sv ]] || continue
            svs+=("$f"); [ -f "${f%.sv}.xdc" ] && withxdc+=("$f")
        done
        if   [ ${#withxdc[@]} -eq 1 ]; then top=${withxdc[0]%.sv}
        elif [ ${#svs[@]} -eq 1 ];     then top=${svs[0]%.sv}
        else die "cannot tell which module is top (${#svs[@]} .sv files, ${#withxdc[@]} with a matching .xdc). Name it:  mac-fpga $target <top>"; fi
    fi
    [ -f "$top.sv" ] || [ -f "$top.v" ] || die "$top.sv not found"
    # every source in the folder is synthesized (submodules may live in their own files); testbenches excluded
    local srcs=()
    for f in *.sv *.v; do [ -f "$f" ] && [[ $f != *_tb.sv && $f != *_tb.v ]] && srcs+=("$f"); done
    case $target in
        sim)
            [ -f "${top}_tb.sv" ] || die "${top}_tb.sv not found. Simulation needs a testbench (see: mac-fpga new example)" ;;
        bit|flash)
            [ -f "$top.xdc" ] || die "$top.xdc not found. Copy the pins you use from:  $HERE/templates/Basys3_Master.xdc"
            [ -s "$FPGA_HOME/chipdb/xc7a35t.bin" ] && [ -x "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" ] \
                || die "toolchain not installed. Run:  mac-fpga install   (status: mac-fpga check)" ;;
    esac
    exec make -s -f "$HERE/templates/Makefile" TOP="$top" SRCS="${srcs[*]}" XDC="$top.xdc" "$target"
}

case "${1:-}" in
    install) shift; exec bash "$HERE/install.sh" "$@" ;;
    check)   cmd_check ;;
    new)     shift; cmd_new "$@" ;;
    sim|bit|flash|clean) cmd_build "$@" ;;
    -v|--version|version) version ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $1" >&2; usage 1 ;;
esac
