#!/usr/bin/env bash
# dewfpga: Basys3 on macOS without Vivado.
#   dewfpga install                 install the toolchain into ~/fpga (safe to re-run)
#   dewfpga check                   verify every piece is in place
#   dewfpga sim | bit | flash | clean [top]
#                                    work on the .sv files in the current folder. top = the .sv that has a
#                                    matching .xdc, or the only .sv; else name it. pins = <top>.xdc or the only .xdc
#   dewfpga new <dir>               blink example: blink.sv + blink_tb.sv + blink.xdc + VS Code task (⌘⇧B = flash)
#   dewfpga uninstall               remove ~/fpga, ~/.dewfpga and the link in Homebrew's bin (brew packages stay)
#   dewfpga --version
# The toolchain lives in $FPGA_HOME (default ~/fpga). Build outputs land next to the .sv; <top>.log has the full place-and-route log.
set -euo pipefail
# resolve symlink chain (npm bin / brew bin). readlink -f is missing on older macOS, so by hand:
resolve() { local f=$1 d; while [ -L "$f" ]; do d=$(cd "$(dirname "$f")" && pwd); f=$(readlink "$f"); [[ $f = /* ]] || f="$d/$f"; done; printf '%s' "$f"; }
SELF="$(resolve "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")/.." && pwd)"
FPGA_HOME="${FPGA_HOME:-$(cat "$HERE/.fpga_home" 2>/dev/null || echo "$HOME/fpga")}"   # install.sh records where it put the tools
[[ $HERE != *[[:space:]]* && $FPGA_HOME != *[[:space:]]* ]] || { echo "ERROR: a path with a space ($HERE / $FPGA_HOME): the FPGA tools cannot handle that. Move the folder or set FPGA_HOME." >&2; exit 1; }

usage()   { sed -n '2,11s/^# \{0,1\}//p' "$SELF"; exit "${1:-0}"; }
version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$HERE/package.json"; }
die()     { echo "ERROR: $*" >&2; exit 1; }

cmd_check() {
    local fail=0
    row() {  # <name> <path|command> <kind f|x|c>
        local name=$1 target=$2 kind=$3 where=""
        case $kind in
            c) where=$(command -v "$target" 2>/dev/null || true) ;;
            x) [ -x "$target" ] && where=$target ;;
            f) [ -s "$target" ] && where=$target ;;
        esac
        if [ -n "$where" ]; then printf '  \033[32m✓\033[0m %-16s %s\n' "$name" "$where"
        else printf '  \033[31m✗\033[0m %-16s MISSING\n' "$name"; fail=1; fi
    }
    echo "dewfpga check  (FPGA_HOME=$FPGA_HOME)"
    row yosys           yosys                                            c
    row iverilog        iverilog                                         c
    row openFPGALoader  openFPGALoader                                   c
    row nextpnr-xilinx  "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" x
    row xc7frames2bit   "$FPGA_HOME/prjxray/build/tools/xc7frames2bit"   x
    row fasm2frames     "$FPGA_HOME/prjxray/utils/fasm2frames.py"        f
    row chipdb          "$FPGA_HOME/chipdb/xc7a35t.bin"                  f
    row venv            "$FPGA_HOME/venv/bin/python"                     x
    if [ -x "$FPGA_HOME/venv/bin/python" ]; then
        if "$FPGA_HOME/venv/bin/python" -c "import fasm, prjxray, yaml, textx, simplejson, intervaltree" 2>/dev/null
        then printf '  \033[32m✓\033[0m %-16s fasm prjxray pyyaml textx simplejson intervaltree\n' "python pkgs"
        else printf '  \033[31m✗\033[0m %-16s missing package\n' "python pkgs"; fail=1; fi
    fi
    if [ $fail -eq 0 ]; then echo "all good."; else echo "something is missing -> dewfpga install"; return 1; fi
}

cmd_new() {
    local dir=${1:-}; [ -n "$dir" ] || usage 1
    [ -e "$dir" ] && die "$dir already exists"
    mkdir -p "$dir/.vscode"
    cp "$HERE"/templates/{blink.sv,blink_tb.sv,blink.xdc} "$dir/"
    # the template task says `make ...` for the manual (Makefile) setup; here the CLI does the work
    sed 's/"make /"dewfpga /' "$HERE/templates/.vscode/tasks.json" > "$dir/.vscode/tasks.json"
    echo "$dir/ ready:  cd $dir && dewfpga flash    (VS Code: ⌘⇧B)"
}

cmd_uninstall() {
    local link; link="$(brew --prefix 2>/dev/null || echo /opt/homebrew)/bin/dewfpga"
    echo "removing: $FPGA_HOME  $HOME/.dewfpga  $link"
    echo "kept: the Homebrew packages (brew uninstall yosys openfpgaloader icarus-verilog cmake ninja eigen pkg-config python@3.14 if you want them gone)"
    case "$FPGA_HOME" in "$HOME"|/|"") die "FPGA_HOME is $FPGA_HOME; refusing to delete that. Remove the five entries by hand: nextpnr-xilinx prjxray chipdb venv install.log" ;; esac
    rm -rf "$FPGA_HOME/nextpnr-xilinx" "$FPGA_HOME/prjxray" "$FPGA_HOME/chipdb" "$FPGA_HOME/venv" "$FPGA_HOME/install.log"
    rmdir "$FPGA_HOME" 2>/dev/null || true      # only if nothing else lives there
    [ "$HERE" = "$HOME/.dewfpga" ] && rm -rf "$HOME/.dewfpga"
    [ -L "$link" ] && rm -f "$link"
    echo "done."
}

cmd_build() {  # <target> [top]
    local target=$1 top=${2:-} xdc
    if [ -z "$top" ]; then
        # top = the .sv that has a matching .xdc; if ambiguous, the only .sv in the folder
        local f svs=() withxdc=()
        for f in *.sv *.v; do
            [ -f "$f" ] && [[ $f != *_tb.sv && $f != *_tb.v ]] || continue
            svs+=("${f%.*}"); [ -f "${f%.*}.xdc" ] && withxdc+=("${f%.*}")
        done
        if   [ ${#withxdc[@]} -eq 1 ]; then top=${withxdc[0]}
        elif [ ${#svs[@]} -eq 1 ];     then top=${svs[0]}
        else die "cannot tell which module is top (${#svs[@]} source files, ${#withxdc[@]} with a matching .xdc). Name it:  dewfpga $target <top>"; fi
    fi
    top=${top%.sv}; top=${top%.v}
    [ -f "$top.sv" ] || [ -f "$top.v" ] || die "$top.sv not found"
    xdc="$top.xdc"
    # every source in the folder is synthesized (submodules may live in their own files); testbenches excluded
    local srcs=()
    for f in *.sv *.v; do
        [ -f "$f" ] && [[ $f != *_tb.sv && $f != *_tb.v ]] || continue
        [[ $f != *[[:space:]]* ]] || die "'$f': file names with spaces are not supported by the tools. Rename it (e.g. ${f// /_})"
        srcs+=("$f")
    done
    grep -qE "^[[:space:]]*module[[:space:]]+$top\b" "${srcs[@]}" 2>/dev/null \
        || die "no 'module $top' in ${srcs[*]}. The top module must be named after its file ($top.sv), or name the file after the module"
    case $target in
        sim)
            [ -f "${top}_tb.sv" ] || die "${top}_tb.sv not found. Simulation needs a testbench (see: dewfpga new example)" ;;
        bit|flash)
            # the pin file: <top>.xdc, or the only .xdc in the folder (a lab folder usually has Basys3_Master.xdc)
            if [ ! -f "$xdc" ]; then
                local xdcs=(); for f in *.xdc; do [ -f "$f" ] && xdcs+=("$f"); done
                if   [ ${#xdcs[@]} -eq 1 ]; then xdc=${xdcs[0]}
                elif [ ${#xdcs[@]} -eq 0 ]; then die "no .xdc pin file in this folder. Copy $HERE/templates/Basys3_Master.xdc here and uncomment the pins you use"
                else die "${#xdcs[@]} .xdc files here and none is named $top.xdc. Keep one, or name it $top.xdc"; fi
            fi
            [[ $xdc != *[[:space:]]* ]] || die "'$xdc': file names with spaces are not supported by the tools. Rename it (e.g. ${xdc// /_})"
            [ -s "$FPGA_HOME/chipdb/xc7a35t.bin" ] && [ -x "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" ] \
                || die "toolchain not installed. Run:  dewfpga install   (status: dewfpga check)" ;;
    esac
    # make's own "*** [target] Error 1" trailer adds nothing to the message the recipe already printed.
    # One merged stream keeps the lines in order; sed always exits 0, so pipefail (set above) hands back make's exit code.
    make -s -f "$HERE/templates/Makefile" TOP="$top" SRCS="${srcs[*]}" XDC="$xdc" CHECKER="$HERE/templates/check_xdc.py" "$target" 2>&1 \
        | sed -E '/^make: \*\*\* \[[^]]*\] Error [0-9]+$/d'
}

case "${1:-}" in
    install) [ $# -eq 1 ] || die "dewfpga install takes no arguments (FPGA_HOME=/elsewhere dewfpga install to relocate)"; exec bash "$HERE/install.sh" ;;
    uninstall) cmd_uninstall ;;
    check)   cmd_check ;;
    new)     shift; cmd_new "$@" ;;
    sim|bit|flash|clean) cmd_build "$@" ;;
    -v|--version|version) version ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $1" >&2; usage 1 ;;
esac
