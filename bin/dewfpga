#!/usr/bin/env bash
# dewfpga: Basys3 on macOS without Vivado.
#   dewfpga install                 install the toolchain into ~/fpga (safe to re-run)
#   dewfpga check                   verify every piece is in place
#   dewfpga sim | bit | flash | clean [top]
#                                    work on the .sv files in the current folder. top = the module nothing else
#                                    instantiates (or name it: a module or a file). pins = <top>.xdc or the only .xdc
#   dewfpga new <dir>               blink example: blink.sv + blink_tb.sv + blink.xdc + VS Code task (⌘⇧B = flash)
#   dewfpga uninstall               remove what install built in ~/fpga (nextpnr-xilinx, yosys-slang, prjxray, chipdb, venv, log),
#                                    the CLI in ~/.dewfpga and its link in Homebrew's bin. Your files and brew packages stay
#   dewfpga --version
# The toolchain lives in $FPGA_HOME (default ~/fpga). Build outputs land next to the .sv; <top>.log has the full place-and-route log.
set -euo pipefail
# resolve symlink chain (npm bin / brew bin). readlink -f is missing on older macOS, so by hand:
resolve() { local f=$1 d; while [ -L "$f" ]; do d=$(cd "$(dirname "$f")" && pwd); f=$(readlink "$f"); [[ $f = /* ]] || f="$d/$f"; done; printf '%s' "$f"; }
SELF="$(resolve "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")/.." && pwd)"
FPGA_HOME="${FPGA_HOME:-$(cat "$HERE/.fpga_home" 2>/dev/null || echo "$HOME/fpga")}"   # install.sh records where it put the tools
# every message in one format (templates/check_xdc.py prints the same): [<file>:<line>: ]<kind> [<code>]: <text> Fix: <fix> <page>
# code = the page's folder under site/errors/. die <code> <text>, or die <file:line> <code> <text> when the problem is in the student's code
SITE=https://nosey-dewdrop.github.io/dewfpga/errors
die()     { local loc=""; case $1 in *:*) loc="$1: "; shift ;; esac; echo "${loc}ERROR [$1]: ${*:2} $SITE/$1/" >&2; exit 1; }
note()    { echo "note [$1]: ${*:2} $SITE/$1/"; }
[[ $HERE != *[[:space:]]* && $FPGA_HOME != *[[:space:]]* ]] || die path-with-space "a path with a space ($HERE / $FPGA_HOME): the FPGA tools cannot handle that. Fix: move the folder to a path without spaces, or set FPGA_HOME to one."

usage()   { sed -n '2,12s/^# \{0,1\}//p' "$SELF"; exit "${1:-0}"; }
version() { sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$HERE/package.json"; }

cmd_check() {
    local fail=0
    row() {  # <name> <path|command> <kind f|x|c>
        local name=$1 target=$2 kind=$3 where=""
        case $kind in
            c) where=$(command -v "$target" 2>/dev/null || true) ;;
            x) [ -x "$target" ] && where=$target ;;
            f) [ -s "$target" ] && where=$target ;;
        esac
        if [ -n "$where" ]; then printf '  \033[32m✓\033[0m %-16s %s\n' "$name" "$where"
        else printf '  \033[31m✗\033[0m %-16s MISSING\n' "$name"; fail=1; fi
    }
    echo "dewfpga check  (FPGA_HOME=$FPGA_HOME)"
    row yosys           yosys                                            c
    # the SystemVerilog reader plugin, compiled against the yosys above: after `brew upgrade yosys` it no longer loads.
    # grep without -q: with pipefail, -q closes the pipe early and yosys' SIGPIPE would read as a failed load
    local so="$FPGA_HOME/yosys-slang/build/slang.so" stale=""
    if [ ! -s "$so" ]; then printf '  \033[31m✗\033[0m %-16s MISSING (the SystemVerilog reader: dewfpga install builds it, about 4 min)\n' yosys-slang; fail=1
    elif yosys -m "$so" -p 'help read_slang' 2>&1 | grep '^ *read_slang \[' >/dev/null; then printf '  \033[32m✓\033[0m %-16s %s\n' yosys-slang "$so"
    else printf '  \033[31m✗\033[0m %-16s %s does not load in %s\n' yosys-slang "$so" "$(yosys -V 2>/dev/null | cut -d' ' -f1-2)"; fail=1; stale=1; fi
    row iverilog        iverilog                                         c
    row openFPGALoader  openFPGALoader                                   c
    row nextpnr-xilinx  "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" x
    row xc7frames2bit   "$FPGA_HOME/prjxray/build/tools/xc7frames2bit"   x
    row fasm2frames     "$FPGA_HOME/prjxray/utils/fasm2frames.py"        f
    row chipdb          "$FPGA_HOME/chipdb/xc7a35t.bin"                  f
    row venv            "$FPGA_HOME/venv/bin/python"                     x
    if [ -x "$FPGA_HOME/venv/bin/python" ]; then
        if "$FPGA_HOME/venv/bin/python" -c "import fasm, prjxray, yaml, textx, simplejson, intervaltree" 2>/dev/null
        then printf '  \033[32m✓\033[0m %-16s fasm prjxray pyyaml textx simplejson intervaltree\n' "python pkgs"
        else printf '  \033[31m✗\033[0m %-16s missing package\n' "python pkgs"; fail=1; fi
    fi
    [ -z "$stale" ] || echo "ERROR [yosys-slang-does-not-load]: $so was built for another yosys (brew upgrade yosys leaves it behind), so the SystemVerilog yosys' own reader refuses would not build. Fix: dewfpga install  (it rebuilds the reader, about 4 min). $SITE/yosys-slang-does-not-load/" >&2
    if [ $fail -eq 0 ]; then echo "all good."; else echo "ERROR [toolchain-not-installed]: something is missing (the ✗ rows above), so dewfpga bit and flash cannot run. Fix: dewfpga install  (safe to re-run; it only builds what is missing). $SITE/toolchain-not-installed/" >&2; return 1; fi
}

cmd_new() {
    local dir=${1:-}; [ -n "$dir" ] || usage 1
    dir=${dir%/}
    [ -e "$dir" ] && die folder-exists "$dir already exists, and dewfpga new does not overwrite. Fix: pick another name, or cd $dir and work there."
    mkdir -p "$dir/.vscode"
    cp "$HERE"/templates/{blink.sv,blink_tb.sv,blink.xdc} "$dir/"
    # the template task says `make ...` for the manual (Makefile) setup; here the CLI does the work
    sed 's/"make /"dewfpga /' "$HERE/templates/.vscode/tasks.json" > "$dir/.vscode/tasks.json"
    cp "$HERE"/templates/.vscode/{settings.json,extensions.json} "$dir/.vscode/"     # iverilog as the linter, the extension recommended
    local q=$dir; [[ $dir == *[[:space:]]* ]] && q="\"$dir\""
    echo "$dir/ ready:  cd $q && dewfpga flash    (VS Code: ⌘⇧B)"
}

cmd_uninstall() {
    local link; link="$(brew --prefix 2>/dev/null || echo /opt/homebrew)/bin/dewfpga"
    local built=(nextpnr-xilinx yosys-slang prjxray chipdb venv install.log) gone=() e
    # compare physical paths (symlinks resolved): FPGA_HOME=~/fpga/.. or a link that points at $HOME must refuse too.
    # cd -P, and no CDPATH: `cd x/l/..` folds the string to x while rm follows the link l first and lands in its target's
    # parent, so the guard and the deletes below must both use the folder the kernel resolves (fh), never the string
    unset CDPATH
    local fh home; fh=$(cd -P -- "$FPGA_HOME" 2>/dev/null && pwd -P || echo "$FPGA_HOME")
    home=$(cd -P -- "$HOME" 2>/dev/null && pwd -P) || die fpga-home-unsafe "HOME=$HOME cannot be opened, so FPGA_HOME=$FPGA_HOME cannot be checked against it; refusing to delete anything. Fix: remove the six entries by hand: ${built[*]}"
    # -ef, not the strings: //Users/you or /users/YOU (APFS ignores case) name the same folder
    if [ -z "$fh" ] || [ "$fh" -ef "$HOME" ] || [ "$fh" -ef / ]; then die fpga-home-unsafe "FPGA_HOME is $FPGA_HOME; refusing to delete that. Fix: remove the six entries by hand: ${built[*]}"; fi
    local up=$home
    while [ "$up" != / ] && [ -n "$up" ]; do
        up=$(dirname "$up")
        [ ! "$fh" -ef "$up" ] || die fpga-home-unsafe "FPGA_HOME is $FPGA_HOME, a parent of your home folder; refusing to delete that. Fix: remove the six entries by hand: ${built[*]}"
    done
    # only what install.sh put there: anything else in FPGA_HOME (your own projects) is left alone
    for e in "${built[@]}"; do [ -e "$fh/$e" ] && gone+=("$fh/$e"); done
    # ~/.dewfpga as the web installer made it; a link there goes, never the folder it points at; a git clone of the CLI is yours; it stays
    local dd="$HOME/.dewfpga"
    if [ "$(cd -P -- "$HERE" && pwd -P)" = "$(cd -P -- "$dd" 2>/dev/null && pwd -P)" ]; then
        if [ -L "$dd" ]; then gone+=("$dd"); elif [ ! -e "$HERE/.git" ] && [ ! -L "$HERE/.git" ]; then gone+=("$HERE"); fi
    fi
    [ -L "$link" ] && [ "$(resolve "$link")" = "$SELF" ] && gone+=("$link")      # only a link to this CLI
    if [ ${#gone[@]} -eq 0 ]; then note no-install-found "nothing to remove: no dewfpga install found in $FPGA_HOME (FPGA_HOME=/elsewhere dewfpga uninstall for one installed elsewhere)."; return; fi
    [ "$fh" = "$FPGA_HOME" ] || echo "FPGA_HOME=$FPGA_HOME is $fh"
    printf 'removing: %s\n' "${gone[@]}"
    rm -rf "${gone[@]}"
    if rmdir "$fh" 2>/dev/null; then echo "removed: $fh (it was empty)"
    elif [ -d "$fh" ]; then echo "kept: $fh (other files live there)"; fi
    echo "kept: the Homebrew packages (brew uninstall yosys openfpgaloader icarus-verilog cmake ninja eigen pkg-config python@3.14 if you want them gone)"
    echo "done."
}

cmd_build() {  # <target> [top]
    local target=$1 top=${2:-} xdc f
    case $top in -*) die unknown-option "unknown option: $top; dewfpga $target takes a module or a file name, nothing else. Fix: dewfpga $target [top]  (dewfpga --help lists the commands)." ;; esac
    top=${top#./}
    [[ $top != */* ]] || die run-inside-the-folder "$top is a path, and dewfpga works on the .sv files in the current folder. Fix: run it inside the folder that holds the .sv files:  cd \"$(dirname "$top")\" && dewfpga $target $(basename "$top")"
    local files=()
    for f in *.sv *.v *.SV *.V; do
        [ -f "$f" ] || continue
        [[ $f != *[[:space:]]* ]] || die file-name-with-space "'$f': file names with spaces are not supported by the tools. Fix: rename it (e.g. ${f// /_})."
        # a UTF-8 byte-order mark (Notepad's "UTF-8 with BOM") makes yosys stop at token 1 with "invalid token"
        [ "$(head -c 3 "$f" | LC_ALL=C od -An -tx1 | tr -d ' \n')" != "efbbbf" ] \
            || die "$f:1" utf8-bom "$f starts with a byte-order mark (saved as 'UTF-8 with BOM'), and yosys stops at its first token. Fix: save it as plain UTF-8, or remove it:  LC_ALL=C sed -i '' \$'1s/^\\xEF\\xBB\\xBF//' $f"
        files+=("$f")
    done
    [ ${#files[@]} -gt 0 ] || die no-source-file "no .sv or .v file in $PWD. Fix: cd into the folder with your design, or start one:  dewfpga new blink"
    # the glob's order follows the locale (design_old.sv sorts before design.sv on one macOS and after it on another);
    # the tools read the files in this order and the messages name them in it, so it is fixed here. No spaces in names (checked above)
    # shellcheck disable=SC2207
    files=($(printf '%s\n' "${files[@]}" | LC_ALL=C sort))
    local xn="" py="$FPGA_HOME/venv/bin/python"; [ -x "$py" ] || py=python3
    # two lines Vivado accepts and yosys and iverilog refuse are written into the student's file first, and each
    # changed line is printed as a note: the course's seven-segment port line (`output [6:0] seg, logic dp`) gets
    # its direction, an instance without a name (`inv(sw[0], led[0]);`) gets one (u_inv). Before sim too: the
    # same folder must pass or fail sim by its code, not by whether a bit ran first. Nothing else is touched.
    [ "$target" = clean ] || "$py" "$HERE/templates/check_xdc.py" --fix-ports "${files[@]}"
    # what is what: the scanner reads the modules. The top is the design module nothing else instantiates
    # (or the one named on the command line, by module or by file); a testbench is a module without ports;
    # file names are free, and never decide the top. One ERROR= line means it could not decide; PROBLEM=
    # lines are the student's mistakes it saw (a $finish in a design, a start value meant as a wire, a
    # module defined twice, a netlist Vivado wrote left in the folder). Both come in the message format
    # above, with the code and the student's file:line; --cmd names this command in the fix.
    for f in *.xdc; do [ -f "$f" ] && xn="$xn,${f%.xdc}"; done
    local scan line design="" tb="" auto=0 problems=0 why=""
    scan=$("$py" "$HERE/templates/check_xdc.py" --scan ${top:+--top "$top"} --xdc "${xn#,}" --cmd "$target" "${files[@]}") || true
    while IFS= read -r line; do
        case $line in
            ERROR=*)   echo "${line#ERROR=}" >&2; exit 1 ;;
            PROBLEM=*) echo "${line#PROBLEM=}" >&2; problems=1 ;;
            TOP=*)     top=${line#TOP=} ;;
            WHY=*)     why=${line#WHY=} ;;
            DESIGN=*)  design=${line#DESIGN=} ;;
            TB=*)      tb=${line#TB=} ;;
            AUTO=*)    auto=${line#AUTO=} ;;
        esac
    done <<< "$scan"
    [ $problems -eq 0 ] || exit 1
    [ -n "$top" ] || die no-top-module "could not find a top module in ${files[*]}. Fix: name it:  dewfpga $target <module>"
    if [ -n "$why" ]; then echo "top module: $top ($why)"
    elif [ "$auto" = 1 ] && [ "$(wc -w <<< "$design")" -gt 1 ]; then echo "top module: $top"; fi
    local srcs=(); read -ra srcs <<< "$design"
    xdc="$top.xdc"
    case $target in
        sim)
            [ -n "$tb" ] || die no-testbench "no testbench for $top in this folder: a testbench is a module without ports that instantiates $top and ends with \$finish; ${top}_tb.sv is the usual name. Fix: write one next to the design; 'dewfpga new blink' gives an example (blink/blink_tb.sv)." ;;
        bit|flash)
            # the pin file: <top>.xdc, or the only .xdc in the folder (a lab folder usually has Basys3_Master.xdc)
            if [ ! -f "$xdc" ]; then
                local xdcs=(); for f in *.xdc; do [ -f "$f" ] && xdcs+=("$f"); done
                if   [ ${#xdcs[@]} -eq 1 ]; then xdc=${xdcs[0]}
                elif [ ${#xdcs[@]} -eq 0 ]; then die no-xdc-file "no .xdc pin file in this folder, so nothing says which pin each port is on. Fix: copy $HERE/templates/Basys3_Master.xdc here and uncomment the pins you use."
                else die two-xdc-files "${#xdcs[@]} .xdc files here (${xdcs[*]}) and none is named $top.xdc, so nothing says which one holds the pins. Fix: keep one, or name it $top.xdc."; fi
            fi
            [[ $xdc != *[[:space:]]* ]] || die file-name-with-space "'$xdc': file names with spaces are not supported by the tools. Fix: rename it (e.g. ${xdc// /_})."
            [ -s "$FPGA_HOME/chipdb/xc7a35t.bin" ] && [ -x "$FPGA_HOME/nextpnr-xilinx/build/nextpnr-xilinx" ] \
                || die toolchain-not-installed "toolchain not installed: no nextpnr-xilinx or chipdb in $FPGA_HOME. Fix: dewfpga install   (status: dewfpga check)." ;;
    esac
    # make's own "*** [target] Error 1" trailer adds nothing to the message the recipe already printed.
    # sim: stdout stays a terminal so $display lines appear as they happen (a pipe would buffer them);
    # only stderr goes through the sed. bit/flash: one merged stream keeps the lines in order, and an
    # empty stream means nothing had changed. sed always exits 0; pipefail (set above) hands back make's code.
    local trailer='/^make: \*\*\* \[[^]]*\] Error [0-9]+$/d'
    if [ "$target" = sim ]; then
        make -s -f "$HERE/templates/Makefile" TOP="$top" SRCS="${srcs[*]}" TB="$tb" XDC="$xdc" CHECKER="$HERE/templates/check_xdc.py" sim 2> >(sed -E "$trailer" >&2)
    else
        DEWFPGA_TMP=$(mktemp -t dewfpga); trap 'rm -f "$DEWFPGA_TMP"' EXIT; local tmp=$DEWFPGA_TMP
        make -s -f "$HERE/templates/Makefile" TOP="$top" SRCS="${srcs[*]}" XDC="$xdc" CHECKER="$HERE/templates/check_xdc.py" "$target" 2>&1 \
            | sed -E "$trailer" | tee "$tmp"
        if [ "$target" = bit ] && [ ! -s "$tmp" ]; then echo "$top.bit is up to date (nothing changed since the last build; dewfpga clean forces a rebuild)"; fi
    fi
}

case "${1:-}" in
    install) [ $# -eq 1 ] || die unknown-option "dewfpga install takes no arguments. Fix: dewfpga install  (FPGA_HOME=/elsewhere dewfpga install to relocate)."; exec bash "$HERE/install.sh" ;;
    uninstall) cmd_uninstall ;;
    check)   cmd_check ;;
    new)     shift; cmd_new "$@" ;;
    sim|bit|flash|clean) cmd_build "$@" ;;
    -v|--version|version) version ;;
    -h|--help|help|"") usage ;;
    *) echo "ERROR [unknown-command]: unknown command: $1. Fix: one of the commands below. $SITE/unknown-command/" >&2; usage 1 ;;
esac
