diff --git a/wasm/ivl_static_modules.cc b/wasm/ivl_static_modules.cc
new file mode 100644
index 0000000..2b1d8a9
--- /dev/null
+++ b/wasm/ivl_static_modules.cc
@@ -0,0 +1,92 @@
+/*
+ * WebAssembly build support: static replacement for dlopen()/dlsym().
+ *
+ * The code generator (tgt-vvp) and the builtin VPI modules are linked
+ * into the ivl / vvp executables. ivl_dlopen() accepts any path whose
+ * basename (minus .tgt/.vpi/.vpl) is in the table below and ivl_dlsym()
+ * resolves the well known entry points by (module, symbol) name.
+ *
+ * Compile with -DIVL_STATIC_TARGETS for the ivl executable (which needs
+ * the tgt-vvp entry points), without it for vvp.
+ */
+#include <cstring>
+#include <cstdio>
+
+extern "C" {
+#ifdef IVL_STATIC_TARGETS
+extern int target_design(void*);
+extern const char* target_query(const char*);
+#endif
+typedef void (*startup_fn)(void);
+extern startup_fn vlog_startup_routines_system[];
+extern startup_fn vlog_startup_routines_v2005_math[];
+extern startup_fn vlog_startup_routines_v2009[];
+extern startup_fn vlog_startup_routines_va_math[];
+extern startup_fn vlog_startup_routines_vhdl_sys[];
+extern startup_fn vlog_startup_routines_vhdl_textio[];
+extern startup_fn vlog_startup_routines_vpi_debug[];
+}
+
+struct static_sym { const char*module; const char*symbol; void*ptr; };
+
+static const static_sym static_syms[] = {
+#ifdef IVL_STATIC_TARGETS
+      { "vvp",         "target_design",         (void*)&target_design },
+      { "vvp",         "target_query",          (void*)&target_query },
+#endif
+      { "system",      "vlog_startup_routines", (void*)vlog_startup_routines_system },
+      { "v2005_math",  "vlog_startup_routines", (void*)vlog_startup_routines_v2005_math },
+      { "v2009",       "vlog_startup_routines", (void*)vlog_startup_routines_v2009 },
+      { "va_math",     "vlog_startup_routines", (void*)vlog_startup_routines_va_math },
+      { "vhdl_sys",    "vlog_startup_routines", (void*)vlog_startup_routines_vhdl_sys },
+      { "vhdl_textio", "vlog_startup_routines", (void*)vlog_startup_routines_vhdl_textio },
+      { "vpi_debug",   "vlog_startup_routines", (void*)vlog_startup_routines_vpi_debug },
+      { 0, 0, 0 }
+};
+
+static char last_error[256];
+
+/* Reduce "/usr/local/lib/ivl/system.vpi" to "system". */
+static void module_basename(const char*path, char*out, size_t len)
+{
+      const char*base = strrchr(path, '/');
+      base = base ? base + 1 : path;
+      strncpy(out, base, len - 1);
+      out[len - 1] = 0;
+      char*dot = strrchr(out, '.');
+      if (dot && (strcmp(dot, ".tgt") == 0 || strcmp(dot, ".vpi") == 0
+                  || strcmp(dot, ".vpl") == 0))
+	    *dot = 0;
+}
+
+extern "C" void* ivl_static_dlopen(const char*name)
+{
+      char base[256];
+      module_basename(name, base, sizeof base);
+      for (const static_sym*cur = static_syms; cur->module; cur += 1) {
+	    if (strcmp(cur->module, base) == 0)
+		  return (void*)cur->module;
+      }
+      snprintf(last_error, sizeof last_error,
+	       "'%s' is not linked into this WebAssembly build "
+	       "(only builtin modules are available)", name);
+      return 0;
+}
+
+extern "C" void* ivl_static_dlsym(void*dll, const char*sym)
+{
+      if (dll == 0) return 0;
+      const char*module = (const char*)dll;
+      if (sym[0] == '_') sym += 1;
+      for (const static_sym*cur = static_syms; cur->module; cur += 1) {
+	    if (strcmp(cur->module, module) == 0 && strcmp(cur->symbol, sym) == 0)
+		  return cur->ptr;
+      }
+      snprintf(last_error, sizeof last_error, "symbol '%s' not found in builtin module '%s'", sym, module);
+      return 0;
+}
+
+extern "C" const char* ivl_static_dlerror(void)
+{
+      return last_error;
+}
diff --git a/wasm/ivl_wasm_system.c b/wasm/ivl_wasm_system.c
new file mode 100644
index 0000000..e3524cb
--- /dev/null
+++ b/wasm/ivl_wasm_system.c
@@ -0,0 +1,124 @@
+/*
+ * WebAssembly build support: in-process replacement for the system()
+ * calls made by the iverilog driver. The driver builds shell command
+ * lines of the forms
+ *
+ *     <dir>/ivlpp -V
+ *     <dir>/ivl -V -C"..." -C"..."
+ *     <dir>/ivlpp ... -F"..." -f"..." -p"..." > "out"
+ *     <dir>/ivlpp ... -F"..." -f"..." -p"..." |<dir>/ivl ... -C"..." -- -
+ *
+ * There is no fork/exec/pipe in WebAssembly, so the command line is
+ * tokenised here (double quotes, '|' and '>' are understood), the pipe is
+ * replaced by a temporary file (ivlpp -o <tmp>; ivl reads <tmp> instead
+ * of "-"), and the statically linked ivlpp_main()/ivl_main() are called.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <getopt.h>
+
+extern int ivlpp_main(int argc, char*argv[]);
+extern int ivl_main(int argc, char*argv[]);
+
+#define MAX_ARGS 4096
+
+static int tokenize(const char*cmd, char**argv)
+{
+      int argc = 0;
+      char*buf = malloc(strlen(cmd) + 1);
+      char*out = buf;
+      const char*cp = cmd;
+      while (*cp) {
+	    while (*cp == ' ' || *cp == '\t') cp += 1;
+	    if (*cp == 0) break;
+	    if (*cp == '|' || *cp == '>') {
+		  argv[argc] = out; *out++ = *cp++; *out++ = 0; argc += 1;
+		  continue;
+	    }
+	    argv[argc] = out;
+	    int quote = 0;
+	    while (*cp && (quote || (*cp != ' ' && *cp != '\t' && *cp != '|' && *cp != '>'))) {
+		  if (*cp == '"') { quote = !quote; cp += 1; continue; }
+		  *out++ = *cp++;
+	    }
+	    *out++ = 0;
+	    argc += 1;
+	    if (argc >= MAX_ARGS - 4) break;
+      }
+      argv[argc] = 0;
+      return argc;
+}
+
+static const char*base_name(const char*path)
+{
+      const char*s = strrchr(path, '/');
+      return s ? s + 1 : path;
+}
+
+static int run_stage(int argc, char**argv)
+{
+      const char*prog = base_name(argv[0]);
+      int rc;
+      optind = 0;  /* musl getopt: full reset */
+      fflush(stdout); fflush(stderr);
+      if (strcmp(prog, "ivlpp") == 0)
+	    rc = ivlpp_main(argc, argv);
+      else if (strcmp(prog, "ivl") == 0)
+	    rc = ivl_main(argc, argv);
+      else {
+	    fprintf(stderr, "iverilog(wasm): cannot run \"%s\": only ivlpp and ivl are built in.\n", argv[0]);
+	    rc = 127;
+      }
+      fflush(stdout); fflush(stderr);
+      return rc;
+}
+
+int ivl_wasm_system(const char*cmd)
+{
+      static char*argv[MAX_ARGS];
+      int argc = tokenize(cmd, argv);
+      char pipe_path[64];
+      int have_pipe = 0;
+      int rc = 0;
+
+      snprintf(pipe_path, sizeof pipe_path, "/tmp/ivlpp_pipe_%d", (int)getpid());
+
+	/* Split into stages at '|'. */
+      int start = 0;
+      while (start < argc && rc == 0) {
+	    int end = start;
+	    while (end < argc && strcmp(argv[end], "|") != 0) end += 1;
+	    int next_is_pipe = (end < argc);
+	    char*stage[MAX_ARGS];
+	    int n = 0;
+	    stage[n++] = argv[start];
+	      /* stdout redirection ("> file" or a pipe) becomes "-o file",
+		 placed before the positional arguments for getopt's sake. */
+	    if (next_is_pipe) {
+		  stage[n++] = "-o"; stage[n++] = pipe_path;
+	    }
+	    for (int i = start + 1; i < end; i += 1) {
+		  if (strcmp(argv[i], ">") == 0 && i + 1 < end) {
+			stage[n++] = "-o"; stage[n++] = argv[i+1]; i += 1;
+			continue;
+		  }
+		  stage[n++] = argv[i];
+	    }
+	    if (have_pipe) {
+		    /* the previous stage's output becomes this stage's stdin */
+		  if (freopen(pipe_path, "r", stdin) == 0) {
+			fprintf(stderr, "iverilog(wasm): cannot reopen stdin on %s\n", pipe_path);
+			rc = 1;
+			break;
+		  }
+	    }
+	    stage[n] = 0;
+	    rc = run_stage(n, stage);
+	    have_pipe = next_is_pipe;
+	    start = end + 1;
+      }
+      unlink(pipe_path);
+      return (rc & 0xff) << 8;   /* wait(2) status as the driver expects */
+}
